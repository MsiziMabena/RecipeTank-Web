<Page x:Class="RecipeTank.DeleteRecipe"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RecipeTank"
      mc:Ignorable="d" 
     d:Style="{StaticResource PageStyle}"
      Title="Delete A Recipe">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Height="585" Width="972">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Label Content="Delete A Recipe" Style="{StaticResource PageHeader}"
               Grid.Row="0" Margin="161,30,0,30" Background="#FFEAE227" Grid.ColumnSpan="2" HorizontalAlignment="Left"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="67,138,-278,-168" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="0.215"/>
                    <RotateTransform/>
                    <TranslateTransform Y="1.407"/>
                </TransformGroup>
            </StackPanel.RenderTransform>
            <Label Content="Select A Recipe" Style="{StaticResource InputLabel}"
                    Target="{Binding ElementName=SelectRecCB}" Background="#FFEAE227" />
        </StackPanel>
        <Button Content="Delete Recipe" x:Name="deleteRecipe" Click="deleteRecipe_Click" Style="{StaticResource defaultButton}" Background="#FF9E9700" Grid.Column="1" Margin="451,275,92,-324" Grid.Row="2" />
        <ComboBox x:Name="SelectRecCB" Style="{StaticResource InputComboBox}" Grid.Column="1" HorizontalAlignment="Left" Margin="324,224,0,-250" Grid.Row="2" Width="389" />

    </Grid>
</Page>

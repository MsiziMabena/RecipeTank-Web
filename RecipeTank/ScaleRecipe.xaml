<Page x:Class="RecipeTank.ScaleRecipe"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RecipeTank"
      mc:Ignorable="d" 
     d:Style="{StaticResource PageStyle}"
      Title="Scale A Recipe">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Height="640" Width="786">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Label Content="Scale A Recipe" Grid.ColumnSpan="3" Style="{StaticResource PageHeader}"
               Grid.Row="0" Grid.Column="0" Margin="0 30"/>

        <Label x:Name="ErrorMessage" Style="{StaticResource ErrorLabel}" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="4"
               Content="" />

        <StackPanel Margin="231,80,-166,26" Grid.RowSpan="2" Grid.Column="1">
            <Label Content="Select A Recipe" Style="{StaticResource InputLabel}"
                    Target="{Binding ElementName=SelectRecCB}" Background="#FFBB4BFD" Height="40" />

            <ComboBox x:Name="SelectRecCB" Style="{StaticResource InputComboBox}" Margin="0, 0, 0, 30" >
            </ComboBox>

            <Label Content="Select A Scaling Factor" Style="{StaticResource InputLabel}"
                    Target="{Binding ElementName=SelectRecCB}" Background="#FFBB4BFD" Width="214" Height="40" />
            <ComboBox x:Name="ScaeByCB" Style="{StaticResource InputComboBox}" Margin="0, 0, 0, 30" >
                <ComboBoxItem Content="2x (Double)" />
                <ComboBoxItem Content="3x (Tripple)" />
                <ComboBoxItem Content="4x (Quaduple)" />
            </ComboBox>


            <Button Content="Scale Recipe" x:Name="scaleRecipe" Click="scaleRecipe_Click" Style="{StaticResource defaultButton}" Background="#FF7C16B9" Width="202" />
            <Button Content="ResetQuantities" x:Name="resetQuant" Click="resetQuant_Click" Style="{StaticResource defaultButton}" 
                    Margin="0, 20, 0, 0" Background="#FF7C16B9" Width="201"/>
        </StackPanel>

        <StackPanel x:Name="RecipeTable" Margin="188,23,-239,-198" Background="#FFDFB3F9" Grid.Row="2" Grid.Column="1" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="0.245"/>
                    <RotateTransform/>
                    <TranslateTransform Y="0.701"/>
                </TransformGroup>
            </StackPanel.RenderTransform>
            <Label Content="Recipe Information below" />
        </StackPanel>
    </Grid>
</Page>
